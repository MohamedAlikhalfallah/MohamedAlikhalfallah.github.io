---
import { getEntry } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '../styles/global.css';
import { useUI, type Lang } from '../i18n';

interface Props {
    lang: Lang;
    title: string;
    description: string;
    // path of this page without the language, e.g. "/" or "/projects/abc/"
    path?: string;
    // true on the home page: the big hero lives inside the header and shrinks into the bar
    hero?: boolean;
    // picture shown when the link is shared (LinkedIn, WhatsApp, …)
    image?: string;
    // true for pages that search engines should not list (404)
    noindex?: boolean;
}

const { lang, title, description, path = '/', hero = false, image = '/images/og.png', noindex = false } = Astro.props;
const ui = useUI(lang);
const profile = (await getEntry('profile', 'profile'))!.data;
const other: Lang = lang === 'de' ? 'en' : 'de';
const home = `/${lang}/`;

// 3D page transition: the old page tilts away into the screen, the new one swings in.
// The keyframes "page-out" and "page-in" are in global.css.
const flip3d = {
    forwards: {
        old: { name: 'page-out', duration: '0.45s', easing: 'cubic-bezier(0.4, 0, 1, 1)', fillMode: 'both' },
        new: { name: 'page-in', duration: '0.55s', easing: 'cubic-bezier(0, 0, 0.2, 1)', delay: '0.1s', fillMode: 'both' },
    },
    backwards: {
        old: { name: 'page-out-back', duration: '0.45s', easing: 'cubic-bezier(0.4, 0, 1, 1)', fillMode: 'both' },
        new: { name: 'page-in-back', duration: '0.55s', easing: 'cubic-bezier(0, 0, 0.2, 1)', delay: '0.1s', fillMode: 'both' },
    },
};
const site = Astro.site!;
const canonical = new URL(`/${lang}${path}`, site).href;
const ogImage = new URL(image, site).href;
---
<!doctype html>
<html lang={lang}>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0e1318" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(`/en${path}`, site).href} />
    <link rel="alternate" hreflang="de" href={new URL(`/de${path}`, site).href} />

    <!-- link preview for LinkedIn, WhatsApp, X, Slack, … -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- smooth page changes without reloading (with our 3D animation, see global.css) -->
    <ClientRouter />
</head>
<body>
<header class:list={['site-header', hero ? 'has-hero' : 'compact']}>
    {hero
        ? <slot name="hero" />
        : <canvas class="bar-grid" aria-hidden="true"></canvas>}

    <div class="bar-wrap">
        <div class="container bar">
            <a class="brand" href={home} aria-label={profile.name}>
                <span class="logo">mak<span>_</span></span>
                <span class="identity">
              <img class="avatar" src={profile.photo} alt="" width="36" height="36" />
              <span class="name">{profile.name}</span>
            </span>
            </a>
            <nav aria-label="Main">
                <a href={`${home}#about`}>{ui('nav.about')}</a>
                <a href={`${home}#projects`}>{ui('nav.projects')}</a>
                <a href={`${home}#experience`}>{ui('nav.experience')}</a>
                <a href={`${home}#contact`}>{ui('nav.contact')}</a>
            </nav>
            <a class="lang" href={`/${other}${path}`} hreflang={other} lang={other}>
                {ui('switch.label')}
            </a>
        </div>
    </div>
</header>

<main transition:animate={flip3d}>
    <slot />
</main>

<footer class="site-footer">
    <div class="container">
        <p>© {new Date().getFullYear()} {profile.name} · {ui('footer.built')}</p>
    </div>
</footer>
</body>
</html>

<style>
    .site-header {
        position: sticky;
        top: 0;
        z-index: 10;
        overflow: hidden;
        border-bottom: 1px solid var(--line);
    }
    /* pages without a hero: a slim 64px bar with its own small grid */
    .site-header.compact { height: 64px; background: rgb(14 19 24 / 0.9); }
    /* home page: starts as a normal block; the script makes it sticky and shrinking */
    .site-header.has-hero { position: relative; background: var(--bg); }

    .bar-grid { position: absolute; inset: 0; width: 100%; height: 100%; }

    .bar-wrap {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 64px;
        z-index: 1;
        will-change: transform;
    }
    .bar { display: flex; align-items: center; gap: 2rem; height: 100%; }

    /* "mak_" and "photo + name" sit on top of each other */
    .brand { display: grid; align-items: center; text-decoration: none; color: var(--text); }
    .brand > * { grid-area: 1 / 1; }
    .logo { font-family: var(--font-mono); font-weight: 700; font-size: 1.1rem; }
    .logo span { color: var(--accent); animation: blink 1.1s steps(1) infinite; }
    .identity { display: flex; align-items: center; gap: 0.75rem; }
    .avatar {
        width: 36px;
        height: 36px;
        object-fit: cover;
        object-position: top;
        border-radius: 50%;
        border: 2px solid var(--accent);
    }
    .name { font-family: var(--font-mono); font-weight: 600; font-size: 0.95rem; white-space: nowrap; }

    /* start state on the home page: only "mak_" (the script takes over from here) */
    .has-hero .identity { opacity: 0; }
    .compact .logo { display: none; }

    .bar nav { display: flex; gap: 1.5rem; margin-left: auto; }
    .bar nav a, .lang {
        font-family: var(--font-mono);
        font-size: 0.875rem;
        color: var(--muted);
        text-decoration: none;
    }
    .bar nav a:hover, .lang:hover { color: var(--text); }
    .lang { border: 1px solid var(--line); padding: 0.25rem 0.6rem; border-radius: 4px; background: var(--bg); }

    .site-footer { border-top: 1px solid var(--line); padding-block: 2rem; color: var(--muted); font-size: 0.875rem; }
    .site-footer p { margin: 0; max-width: none; }

    @keyframes blink { 50% { opacity: 0; } }
    @media (prefers-reduced-motion: reduce) { .logo span { animation: none; } }
    @media (max-width: 860px) { .bar nav { display: none; } .lang { margin-left: auto; } }
    @media (max-width: 400px) { .name { font-size: 0.8rem; } }
</style>

<script>
    import { startOccupancyGrid } from '../scripts/occupancy-grid';
    import { setupReveal } from '../scripts/reveal';

    // "astro:page-load" runs on the first visit and after every page change
    document.addEventListener('astro:page-load', () => {
        // stop listeners and animations of this page when we leave it
        const stop = new AbortController();
        document.addEventListener('astro:before-swap', () => stop.abort(), { once: true });
        setupHeader(stop.signal);
        setupReveal(stop.signal);
    });

    function setupHeader(signal: AbortSignal) {
        const header = document.querySelector<HTMLElement>('.site-header')!;
        const bar = header.querySelector<HTMLElement>('.bar-wrap')!;
        const logo = header.querySelector<HTMLElement>('.logo')!;
        const identity = header.querySelector<HTMLElement>('.identity')!;
        const avatar = header.querySelector<HTMLElement>('.avatar')!;
        const smallName = header.querySelector<HTMLElement>('.name')!;
        const hero = header.querySelector<HTMLElement>('.hero');

        const clamp = (v: number) => Math.min(1, Math.max(0, v));

        if (!hero) {
            // ----- Pages without hero: slim bar with a small grid scanning from the avatar -----
            const canvas = header.querySelector<HTMLCanvasElement>('.bar-grid')!;
            startOccupancyGrid(canvas, {
                cell: 10,
                layout: 'corridor',
                rays: 18,
                maxOccupied: 0.5,
                maxFree: 0.16,
                signal,
                sensor: () => {
                    const box = canvas.getBoundingClientRect();
                    const a = avatar.getBoundingClientRect();
                    return { x: a.left + a.width / 2 - box.left, y: a.top + a.height / 2 - box.top };
                },
            });
            return;
        }

        // ----- Home page: the hero shrinks into the bar while you scroll -----
        // The header is sticky with a negative "top", so it scrolls up until only 64px are left.
        // While it scrolls, the big name and photo stay on screen, fly into the bar and shrink
        // (p goes from 0 to 1).
        const bigName = hero.querySelector<HTMLElement>('.morph-name')!;
        const bigPhoto = hero.querySelector<HTMLElement>('.morph-photo')!;
        const figure = hero.querySelector<HTMLElement>('.photo')!;
        const fades = hero.querySelectorAll<HTMLElement>('.fade');

        type Box = { x: number; y: number; w: number; h: number };
        let D = 0;                                 // how far you scroll until the bar is fully small
        let nameFrom: Box, nameTo: Box, photoFrom: Box, photoTo: Box;
        let nameScale = 1;

        // position of an element inside the header
        const box = (el: HTMLElement): Box => {
            const r = el.getBoundingClientRect(), h = header.getBoundingClientRect();
            return { x: r.left - h.left, y: r.top - h.top, w: r.width, h: r.height };
        };

        function measure() {
            // reset everything to the start state, then measure
            for (const el of [bigName, bigPhoto, bar]) el.style.transform = '';
            bigPhoto.style.clipPath = '';
            header.style.position = 'relative';
            header.style.top = '';

            D = header.offsetHeight - 64;
            nameFrom = box(bigName);
            photoFrom = box(bigPhoto);
            nameTo = box(smallName);
            photoTo = box(avatar);
            nameScale = parseFloat(getComputedStyle(smallName).fontSize) / parseFloat(getComputedStyle(bigName).fontSize);

            header.style.position = 'sticky';
            header.style.top = `${-D}px`;
            update();
        }

        function update() {
            const s = Math.min(Math.max(window.scrollY, 0), D);  // scrolled distance (max D)
            const p = D > 0 ? s / D : 1;                          // progress 0 … 1
            const end = clamp((p - 0.75) / 0.25);                 // last quarter: swap big → small

            // the bar always stays at the top of the screen
            bar.style.transform = `translateY(${s}px)`;
            bar.style.background = `rgb(14 19 24 / ${end * 0.85})`;

            // name flies into the bar and shrinks
            const ns = 1 + p * (nameScale - 1);
            bigName.style.transform =
                `translate(${p * (nameTo.x - nameFrom.x)}px, ${s + p * (nameTo.y - nameFrom.y)}px) scale(${ns})`;
            bigName.style.opacity = String(1 - end);
            smallName.style.opacity = String(end);

            // photo flies into the bar, gets cropped to a circle and shrinks
            const ps = 1 + p * (photoTo.w / photoFrom.w - 1);
            const crop = p * Math.max(0, photoFrom.h - photoFrom.w);
            const radius = 4 + p * (photoFrom.w / 2 - 4);
            bigPhoto.style.transform =
                `translate(${p * (photoTo.x - photoFrom.x)}px, ${s + p * (photoTo.y - photoFrom.y)}px) scale(${ps})`;
            bigPhoto.style.clipPath = `inset(0 0 ${crop}px 0 round ${radius}px)`;
            bigPhoto.style.opacity = String(1 - end);
            avatar.style.opacity = String(end);
            figure.style.setProperty('--brackets', String(1 - clamp(p * 3)));

            // the rest of the hero text fades out, "mak_" makes room for the name
            fades.forEach((el) => (el.style.opacity = String(1 - clamp(p * 3))));
            logo.style.opacity = String(1 - clamp(p * 3));
            identity.style.opacity = '1';
            identity.style.pointerEvents = end > 0.5 ? 'auto' : 'none';
        }

        let queued = false;
        window.addEventListener('scroll', () => {
            if (queued) return;
            queued = true;
            requestAnimationFrame(() => { queued = false; update(); });
        }, { passive: true, signal });
        window.addEventListener('resize', measure, { signal });
        // measure once fonts are loaded, so the sizes are correct
        document.fonts.ready.then(() => { if (!signal.aborted) measure(); });
        measure();
    }
</script>