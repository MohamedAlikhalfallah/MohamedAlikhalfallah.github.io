---
import type { CollectionEntry } from 'astro:content';
import { t, useUI, type Lang } from '../i18n';

interface Props { lang: Lang; profile: CollectionEntry<'profile'>['data']; }
const { lang, profile } = Astro.props;
const ui = useUI(lang);
---
<section id="experience" class="section">
    <div class="container">
        <h2>{ui('nav.experience')}</h2>
        <div class="cols">
            <div>
                <h3>{ui('exp.work')}</h3>
                <ol class="timeline">
                    {profile.experience.map((e) => (
                            <li>
                                <p class="period">{t(e.period, lang)}</p>
                                <p class="title">{t(e.title, lang)}</p>
                                <p class="org">{e.org}</p>
                                {e.points && e.points[lang].length > 0 && (
                                        <ul>{e.points[lang].map((p) => <li>{p}</li>)}</ul>
                                )}
                            </li>
                    ))}
                </ol>
            </div>
            <div>
                <h3>{ui('exp.education')}</h3>
                <ol class="timeline">
                    {profile.education.map((e) => (
                            <li>
                                <p class="period">{t(e.period, lang)}</p>
                                <p class="title">{t(e.degree, lang)}</p>
                                <p class="org">{t(e.school, lang)}</p>
                                {e.details && <p class="details">{t(e.details, lang)}</p>}
                            </li>
                    ))}
                </ol>
            </div>
        </div>

        <h3 class="skills-title" id="skills">{ui('nav.skills')}</h3>
        <dl class="skills">
            {profile.skills.map((s) => (
                    <div>
                        <dt>{t(s.group, lang)}</dt>
                        <dd><ul class="tags">{s.items.map((i) => <li>{i}</li>)}</ul></dd>
                    </div>
            ))}
        </dl>
    </div>
</section>

<style>
    .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; }
    h3 { color: var(--muted); font-size: 0.95rem; font-weight: 500; margin-bottom: 1.25rem; }

    .timeline { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--line); }
    .timeline > li { position: relative; padding: 0 0 1.75rem 1.5rem; }
    .timeline > li::before {
        content: '';
        position: absolute;
        left: -5px;
        top: 0.45rem;
        width: 9px;
        height: 9px;
        background: var(--accent);
        border-radius: 1px;
    }
    .timeline p { margin: 0; }
    .period { font-family: var(--font-mono); font-size: 0.85rem; color: var(--muted); }
    .title { font-weight: 600; font-size: 1.1rem; margin-top: 0.2rem !important; }
    .org { color: var(--muted); }
    .details { margin-top: 0.5rem !important; }

    .skills-title { margin-top: 3.5rem; }
    .skills { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem 2rem; margin: 0; }
    .skills dt { font-weight: 500; margin-bottom: 0.5rem; }
    .skills dd { margin: 0; }

    @media (max-width: 760px) { .cols { grid-template-columns: 1fr; gap: 2rem; } }
</style>