---
import { useUI, type Lang } from '../i18n';

interface Props { lang: Lang; accessKey: string; name: string; }
const { lang, accessKey, name } = Astro.props;
const ui = useUI(lang);
---
<!-- The form sends the message to Web3Forms, which forwards it to my email.
     The texts for "sending / success / error" are stored in data-* attributes for the script. -->
<form
        class="contact-form"
        data-sending={ui('form.sending')}
        data-success={ui('form.success')}
        data-error={ui('form.error')}
>
    <h3>{ui('form.title')}</h3>

    <input type="hidden" name="access_key" value={accessKey} />
    <input type="hidden" name="subject" value={`Portfolio (${lang.toUpperCase()}): new message for ${name}`} />
    <input type="hidden" name="from_name" value="Portfolio contact form" />
    <!-- spam trap: real people never see or tick this box, bots do -->
    <input type="checkbox" name="botcheck" class="trap" tabindex="-1" autocomplete="off" aria-hidden="true" />

    <div class="row">
        <label>
            <span>{ui('form.name')}</span>
            <input type="text" name="name" required autocomplete="name" maxlength="100" />
        </label>
        <label>
            <span>{ui('form.email')}</span>
            <input type="email" name="email" required autocomplete="email" maxlength="200" />
        </label>
    </div>
    <label>
        <span>{ui('form.message')}</span>
        <textarea name="message" required rows="6" maxlength="5000"></textarea>
    </label>

    <div class="actions">
        <button class="btn primary" type="submit">{ui('form.send')}</button>
        <p class="status" role="status" aria-live="polite"></p>
    </div>
</form>

<style>
    /* full width, like the other sections */
    .contact-form {
        display: grid;
        gap: 1.5rem;
        margin-top: 3rem;
        padding: 2.5rem;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius);
    }
    h3 { margin-bottom: 0.25rem; }
    .row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
    label { display: grid; gap: 0.4rem; }
    label span { font-family: var(--font-mono); font-size: 0.8rem; color: var(--muted); }
    input, textarea {
        width: 100%;
        padding: 0.7rem 0.85rem;
        font: inherit;
        color: var(--text);
        background: var(--bg);
        border: 1px solid var(--line);
        border-radius: 4px;
    }
    textarea { resize: vertical; min-height: 200px; }
    input:focus, textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 20%, transparent); }
    .trap { display: none; }
    .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; }
    .actions .btn { cursor: pointer; }
    .actions .btn:disabled { opacity: 0.6; cursor: wait; }
    .status { margin: 0; font-size: 0.95rem; }
    .status.ok { color: var(--free); }
    .status.fail { color: #ff7b72; }
    @media (max-width: 640px) { .row { grid-template-columns: 1fr; } .contact-form { padding: 1.25rem; } }
</style>

<script>
    // Send the form in the background (no page reload) and show the result.
    document.addEventListener('astro:page-load', () => {
        const form = document.querySelector<HTMLFormElement>('.contact-form');
        if (!form) return;
        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
        const status = form.querySelector<HTMLElement>('.status')!;

        form.addEventListener('submit', async (event) => {
            event.preventDefault();
            button.disabled = true;
            status.className = 'status';
            status.textContent = form.dataset.sending!;

            try {
                const data = Object.fromEntries(new FormData(form));
                const response = await fetch('https://api.web3forms.com/submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                    body: JSON.stringify(data),
                });
                const result = await response.json();
                if (!response.ok || !result.success) throw new Error(result.message);

                status.classList.add('ok');
                status.textContent = form.dataset.success!;
                form.reset();
            } catch {
                status.classList.add('fail');
                status.textContent = form.dataset.error!;
            } finally {
                button.disabled = false;
            }
        });
    });
</script>