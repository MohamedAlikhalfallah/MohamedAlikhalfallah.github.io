---
import { getEntry, getCollection } from 'astro:content';
import { languages, t, useUI, type Lang } from '../../i18n';

export function getStaticPaths() {
    return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const ui = useUI(lang);
const profile = (await getEntry('profile', 'profile'))!.data;
const projects = (await getCollection('projects'))
    .map((p) => p.data)
    .filter((p) => !p.hidden);
const other = lang === 'de' ? 'en' : 'de';
---
<html lang={lang}>
<head><meta charset="utf-8" /><title>{profile.name}</title></head>
<body>
<a href={`/${other}/`}>{ui('switch')}</a>
<img src={profile.photo} alt={profile.name} width="160" />
<h1>{profile.name}</h1>
<p>{t(profile.role, lang)} · {profile.location}</p>
<p>{t(profile.headline, lang)}</p>

<h2>{ui('nav.about')}</h2>
<p>{t(profile.about, lang)}</p>

<h2>{ui('nav.projects')}</h2>
<ul>
    {projects.map((p) => <li><strong>{p.title}</strong> – {t(p.description, lang)}</li>)}
</ul>

<h2>{ui('nav.contact')}</h2>
<p>
    <a href={`mailto:${profile.email}`}>{profile.email}</a> ·
    <a href={profile.linkedin}>LinkedIn</a> ·
    <a href={profile.github}>GitHub</a>
</p>
</body>
</html>