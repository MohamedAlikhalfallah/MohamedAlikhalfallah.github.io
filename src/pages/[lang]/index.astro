---
import { getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import About from '../../components/About.astro';
import Projects from '../../components/Projects.astro';
import Experience from '../../components/Experience.astro';
import Contact from '../../components/Contact.astro';
import { languages, t, type Lang } from '../../i18n';

export function getStaticPaths() {
    return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const profile = (await getEntry('profile', 'profile'))!.data;
---
<Layout
        lang={lang}
        title={`${profile.name} – ${t(profile.role, lang)}`}
        description={`${t(profile.headline, lang)} ${t(profile.availability, lang)}.`}
        hero
>
    <Hero slot="hero" lang={lang} profile={profile} />
    <About lang={lang} profile={profile} />
    <Projects lang={lang} github={profile.github} />
    <Experience lang={lang} profile={profile} />
    <Contact lang={lang} profile={profile} />
</Layout>