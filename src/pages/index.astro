---
---
<html>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      const lang = (navigator.language || 'en').toLowerCase().startsWith('de') ? 'de' : 'en';
      location.replace('/' + lang + '/');
    </script>
  </head>
  <body>
    <a href="/en/">English</a> | <a href="/de/">Deutsch</a>
  </body>
</html>